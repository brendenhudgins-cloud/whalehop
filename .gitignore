node_modules/
.DS_Store

# NOTHING SECRET LIVES IN THIS REPO. It is public and every file in it is served from
# whalehop.net, so a committed credential is both world-readable and permanent in history.
# The Bluesky app password lives in ~/.whalehop/bsky-app-password.txt, outside the repo.
# These patterns are a backstop for the day someone drops one in here by habit.
*.pw
*.key
*.pem
.env
.env.*
secrets/
bsky/
*password*.txt
*app-password*

# THE TOOLS ARE NOT PUBLIC. This repo is public; the capture and export tools drive
# whale-hop.html by name -- App.startRun, App.game, the BANDS table, scene altitudes, level
# names -- and publishing them publishes the shape of a private build. They stay on disk and
# keep working; they are simply not tracked here.
#
# NO EXCEPTIONS ANY MORE. feeds.mjs was kept for a while because the Pages workflow ran it on
# GitHub's runner, and removing it would have stopped the six-hourly refresh. That step is
# gone: the refresh happens locally and feeds.json is committed. The trade is deliberate --
# the feeds are now as fresh as the last local run rather than always under six hours old --
# and it buys a repo with none of the tooling in it.
tools/

# Generated social media: frames, clips and posters captured from the game. Regenerable from
# tools/capture-media.mjs, and this repo is public, so there is no reason to carry them here.
media/
